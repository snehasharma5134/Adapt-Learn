# AI Learning Companion - Environment Configuration Template

# Core Application Settings
PROJECT_NAME="AI Learning Companion"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Security & Authentication
# Generate a strong 32+ character secret key in production: openssl rand -hex 32
SECRET_KEY="ai-learning-companion-dev-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default (zero-configuration development):
DATABASE_URL="sqlite:///./learning_companion.db"
# PostgreSQL Production Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_learning_companion"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Document Upload & Storage Settings
UPLOAD_DIR="./backend/uploads"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
ALLOWED_DOCUMENT_TYPES=["application/pdf"]

# AI/ML Provider Configuration
# Supported providers: "gemini", "openai", "fallback"
LLM_PROVIDER="gemini"
LLM_API_KEY="" # Leave empty to run the built-in pedagogical simulation engine
LLM_MODEL_NAME="gemini-1.5-pro-latest"

# Embedding Configuration
EMBEDDING_PROVIDER="tfidf" # "tfidf" or "sentence-transformers"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Knowledge Tracing (BKT) Hyperparameters
BKT_PRIOR_L0=0.10
BKT_TRANSIT_T=0.20
BKT_GUESS_G=0.15
BKT_SLIP_S=0.10
